// Hàng Mây ground surfaces (roads, sidewalks, alleys, courtyards, curbs, lawn).
// Owner: world. Mesh UV = world metres / tile size (generated by city_builder.gd); UV2 unused.
// Reads world globals: wetness (rain soak), night_factor. Puddles collect in low spots
// (texture AO/height + macro noise) and get animated rain ripples while it rains.
shader_type spatial;
render_mode depth_draw_opaque, cull_back;

global uniform float wetness;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D orm_tex : hint_default_white, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D noise_tex : filter_linear_mipmap, repeat_enable;      // noise_rgba.png
uniform sampler2D ripple_tex : filter_linear_mipmap, repeat_enable;     // rain_ripples.png
uniform vec4 tint : source_color = vec4(1.0);
uniform float normal_strength = 1.0;
uniform float roughness_mul = 1.0;
// Macro variation (breaks tiling): albedo brightness/hue drift in world space.
uniform float macro_scale = 0.035;
uniform float macro_strength = 0.22;
uniform vec4 macro_tint : source_color = vec4(0.82, 0.78, 0.70, 1.0);
// Puddles: 0 = never (curbs, walls), 1 = roads/sidewalks.
uniform float puddle_amount = 1.0;
uniform float puddle_scale = 0.09;
uniform float ripple_scale = 1.6;
// Upward-facing factor below which nothing gets puddles (vertical curb faces).
uniform float flat_threshold = 0.8;

varying vec3 world_pos;
varying vec3 world_nrm;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	world_nrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

vec3 ripple_normal(vec2 p, float t) {
	// Two scrolling-phase layers of the ripple atlas. B = per-drop phase, A = ring mask.
	vec4 r1 = texture(ripple_tex, p);
	vec4 r2 = texture(ripple_tex, p * 0.73 + vec2(0.37, 0.61));
	float f1 = fract(t * 1.3 + r1.b);
	float f2 = fract(t * 1.1 + r2.b + 0.5);
	vec2 n1 = (r1.rg * 2.0 - 1.0) * (1.0 - f1) * step(0.02, r1.a);
	vec2 n2 = (r2.rg * 2.0 - 1.0) * (1.0 - f2) * step(0.02, r2.a);
	return vec3(n1 + n2, 1.0);
}

void fragment() {
	vec2 uv = UV;
	vec3 alb = texture(albedo_tex, uv).rgb * tint.rgb;
	vec3 orm = texture(orm_tex, uv).rgb;
	vec3 nm = texture(normal_tex, uv).rgb;

	vec4 macro = texture(noise_tex, world_pos.xz * macro_scale);
	vec4 macro2 = texture(noise_tex, world_pos.xz * macro_scale * 0.27 + vec2(0.31, 0.17));
	float m = (macro.r * 0.6 + macro2.g * 0.4) - 0.5;
	alb *= 1.0 + m * macro_strength * 1.6;
	alb = mix(alb, alb * macro_tint.rgb * 1.2, clamp(macro2.r - 0.45, 0.0, 1.0) * macro_strength * 2.0);

	float rough = clamp(orm.g * roughness_mul, 0.03, 1.0);
	float ao = orm.r;

	// --- wetness & puddles -------------------------------------------------------------------
	float flatness = smoothstep(flat_threshold, 1.0, world_nrm.y);
	float w = clamp(wetness, 0.0, 1.0);
	// porous darkening everywhere (vertical faces get less)
	float soak = w * mix(0.55, 1.0, flatness);
	alb *= mix(1.0, 0.58, soak);
	rough = mix(rough, rough * 0.35 + 0.06, soak);
	// puddles: low ground (AO) + macro noise, grow with wetness
	float pn = texture(noise_tex, world_pos.xz * puddle_scale).r * 0.75 + texture(noise_tex, world_pos.xz * puddle_scale * 3.1).g * 0.25;
	float low = (1.0 - ao) * 0.6;
	float level = pn + low;
	float thresh = mix(1.4, 0.62, w * w);
	float puddle = smoothstep(thresh, thresh + 0.06, level) * puddle_amount * flatness;
	alb = mix(alb, alb * 0.55, puddle);
	rough = mix(rough, 0.02, puddle);
	vec3 rn = ripple_normal(world_pos.xz * ripple_scale * 0.25, TIME) ;
	vec3 flat_n = vec3(0.5, 0.5, 1.0);
	vec3 rip = vec3(rn.xy * 0.35 * w, 1.0) * 0.5 + 0.5;
	nm = mix(nm, flat_n, puddle * 0.95);
	nm = mix(nm, rip, puddle * step(0.3, w));

	ALBEDO = alb;
	ROUGHNESS = rough;
	METALLIC = 0.0;
	AO = ao;
	AO_LIGHT_AFFECT = 0.25;
	NORMAL_MAP = nm;
	NORMAL_MAP_DEPTH = normal_strength * mix(1.0, 0.2, puddle);
	SPECULAR = mix(0.5, 0.6, puddle);
}
