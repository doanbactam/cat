[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
night_factor={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.3
}
wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0.3)
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cat_sense={
"type": "float",
"value": 0.0
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="props_dynamic"
3d_physics/layer_5="interactable"
3d_physics/layer_6="climbable"
3d_physics/layer_7="water"
3d_physics/layer_8="vehicles"
3d_physics/layer_9="camera_blocker"
3d_physics/layer_10="triggers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/use_debanding=true
global_illumination/sdfgi/probe_ray_count=2
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
anti_aliasing/quality/use_taa=true
