extends Node3D
## Root of res://scenes/world/city.tscn (owner: world). Generated by
## scripts/world/tools/build_city.gd — do not hand-edit the scene; edit the builder and rebuild.
##
## Runtime helpers + QA hooks (usable with tools/screenshot.sh `call=<method>`):
##   qa_rain(), qa_storm(), qa_fog(), qa_cloudy(), qa_clear(), qa_festival(), qa_perf()

var weather: Node
var environment_ctrl: Node
var night_lights: Node
var _perf_frames := -1
var merged_bodies := 0


func _enter_tree() -> void:
	# children are not in the tree yet: merge per-box asset colliders before Jolt creates them
	if merged_bodies > 0:
		return
	var cm: GDScript = load("res://scripts/world/collider_merge.gd")
	for g in ["Buildings", "Landmarks", "StreetFurniture", "Nature"]:
		var n := get_node_or_null(g)
		if n != null:
			merged_bodies += int(cm.call(&"merge_under", n))


func _ready() -> void:
	add_to_group(&"city")
	weather = get_node_or_null(^"WeatherSystem")
	environment_ctrl = get_node_or_null(^"WorldEnvironment")
	night_lights = get_node_or_null(^"NightLights")
	GameEvents.area_entered.connect(_on_area_entered)


func _on_area_entered(_id: StringName) -> void:
	pass


func get_weather_system() -> Node:
	return weather


func get_player_spawn() -> Marker3D:
	return get_tree().get_first_node_in_group(&"player_spawn") as Marker3D


func get_spawn_transform() -> Transform3D:
	var m := get_player_spawn()
	return m.global_transform if m != null else Transform3D(Basis(), Vector3(0, 1, 0))


## Locations by id (group "location").
func find_location(location_id: StringName) -> Node3D:
	for n in get_tree().get_nodes_in_group(&"location"):
		if StringName(str(n.get_meta(&"location_id", ""))) == location_id:
			return n as Node3D
	return null


# --- QA hooks -------------------------------------------------------------------------------------

func qa_rain() -> void:
	weather.call(&"set_weather_immediate", &"rain", 0.85, 0.9)


func qa_storm() -> void:
	weather.call(&"set_weather_immediate", &"storm", 1.0, 1.0)
	weather.call(&"trigger_lightning", 400.0)


func qa_fog() -> void:
	weather.call(&"set_weather_immediate", &"fog", 1.0, 0.25)


func qa_cloudy() -> void:
	weather.call(&"set_weather_immediate", &"cloudy", 0.8, 0.0)


func qa_clear() -> void:
	weather.call(&"set_weather_immediate", &"clear", 0.0, 0.0)


func qa_festival() -> void:
	if night_lights != null:
		night_lights.call(&"set_festival_override", 1)


func qa_perf() -> void:
	_perf_frames = 40


func _process(_delta: float) -> void:
	if _perf_frames > 0:
		_perf_frames -= 1
		if _perf_frames == 0:
			print("PERF draw_calls=%d primitives=%d objects=%d video_mem_MB=%.1f fps=%.1f" % [
				Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED) / 1048576.0,
				Performance.get_monitor(Performance.TIME_FPS)])
