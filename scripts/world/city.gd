extends Node3D
## Root of res://scenes/world/city.tscn (owner: world). Generated by
## scripts/world/tools/build_city.gd — do not hand-edit the scene; edit the builder and rebuild.
##
## Runtime helpers + QA hooks (usable with tools/screenshot.sh `call=<method>`):
##   qa_rain(), qa_storm(), qa_fog(), qa_cloudy(), qa_clear(), qa_festival(), qa_perf()

var weather: Node
var environment_ctrl: Node
var night_lights: Node
var _perf_frames := -1
var merged_bodies := 0


func _enter_tree() -> void:
	# children are not in the tree yet: merge per-box asset colliders before Jolt creates them
	if merged_bodies > 0:
		return
	var cm: GDScript = load("res://scripts/world/collider_merge.gd")
	for g in ["Buildings", "Landmarks", "StreetFurniture", "Nature", "Water"]:
		var n := get_node_or_null(g)
		if n != null:
			merged_bodies += int(cm.call(&"merge_under", n))
	_apply_visibility_ranges()
	_patch_ground_holes()


## Ground gaps in scenes built before the city_builder fix (2026-11-03): the cat fell through them onto
## the SafetyFloor (y -5.5) and got stuck under the map. Rebuilding the city is not deterministic, so
## the saved scene is patched at load instead; skipped once the scene has GroundBody_tree_pits.
const _GAP_FILLS := [
	[&"concrete", -124.0, -63.0, -121.0, 55.0],   # west edge of the west maze
	[&"concrete", 122.0, -63.0, 124.0, 55.0],     # east edge of the market quarter
	[&"concrete", -124.0, -100.0, -122.0, -77.0], # north row, both ends
	[&"concrete", 122.0, -100.0, 124.0, -77.0],
	[&"concrete", -49.0, -63.0, 44.0, -49.0],     # lake block north row: street sidewalk → park edge
	[&"concrete", -124.0, 69.0, -122.0, 114.0],   # south rows, both ends + south edge
	[&"concrete", 122.0, 69.0, 124.0, 114.0],
	[&"concrete", -122.0, 112.0, -34.0, 114.0],
	[&"concrete", 34.0, 112.0, 122.0, 114.0],
	[&"brick", -34.0, 112.0, 34.0, 114.0],
]
var patched_ground := false


func _patch_ground_holes() -> void:
	var ground := get_node_or_null(^"Ground")
	if ground == null or ground.has_node(^"GroundBody_tree_pits") or ground.has_node(^"GroundPatch"):
		return
	var MU: GDScript = load("res://scripts/world/mesh_util.gd")
	var WM: GDScript = load("res://scripts/world/world_materials.gd")
	var patch := Node3D.new()
	patch.name = "GroundPatch"
	# --- missing block fills: visible ground + a box collider each ---
	var by_key: Dictionary = {}
	for f: Array in _GAP_FILLS:
		var key: StringName = f[0]
		if not by_key.has(key):
			var st := SurfaceTool.new()
			st.begin(Mesh.PRIMITIVE_TRIANGLES)
			by_key[key] = st
		MU.call(&"rect_xz", by_key[key], float(f[1]), float(f[2]), float(f[3]), float(f[4]), 0.0, float(WM.call(&"tile_of", key)))
	for key: StringName in by_key:
		var st: SurfaceTool = by_key[key]
		st.generate_tangents()
		var mi := MeshInstance3D.new()
		mi.name = "Ground_" + String(key)
		mi.mesh = st.commit()
		var existing := ground.get_node_or_null(NodePath("Ground_" + String(key))) as MeshInstance3D
		var mat: Material = existing.mesh.surface_get_material(0) if existing != null and existing.mesh != null else WM.call(&"ground", key)
		mi.mesh.surface_set_material(0, mat)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		patch.add_child(mi)
	for f: Array in _GAP_FILLS:
		var body := StaticBody3D.new()
		body.collision_layer = 1
		body.collision_mask = 0
		body.set_meta(&"surface", &"tile" if f[0] == &"brick" else &"concrete")
		var cs := CollisionShape3D.new()
		var box := BoxShape3D.new()
		var w := float(f[3]) - float(f[1])
		var d := float(f[4]) - float(f[2])
		box.size = Vector3(w, 0.2, d)
		cs.shape = box
		cs.position = Vector3(float(f[1]) + w * 0.5, -0.1, float(f[2]) + d * 0.5)
		body.add_child(cs)
		patch.add_child(body)
	# --- tree-pit soil: the pit quads live in the collider-less lakebed mesh at y -0.04 ---
	var lakebed := ground.get_node_or_null(^"Ground_lakebed") as MeshInstance3D
	if lakebed != null and lakebed.mesh != null:
		var faces := lakebed.mesh.get_faces()
		var pit_faces := PackedVector3Array()
		for i in range(0, faces.size(), 3):
			var a := faces[i]
			var b := faces[i + 1]
			var c := faces[i + 2]
			if absf(a.y + 0.04) < 0.005 and absf(b.y + 0.04) < 0.005 and absf(c.y + 0.04) < 0.005:
				pit_faces.append_array([a, b, c])
		if not pit_faces.is_empty():
			var pits := StaticBody3D.new()
			pits.name = "GroundBody_tree_pits"
			pits.collision_layer = 1
			pits.collision_mask = 0
			pits.set_meta(&"surface", &"dirt")
			var shape := ConcavePolygonShape3D.new()
			shape.backface_collision = true
			shape.set_faces(pit_faces)
			var pcs := CollisionShape3D.new()
			pcs.shape = shape
			pits.add_child(pcs)
			patch.add_child(pits)
	ground.add_child(patch)
	patched_ground = true


## Size-based draw distances for everything instanced from asset scenes (GLB sub-meshes cannot be
## edited in the saved scene). Small clutter pops out first; facades and roofs stay for vistas.
## Values scale with graphics/quality (low 0.6 … ultra 1.5).
var visibility_ranged := 0

func _apply_visibility_ranges() -> void:
	var mult := 1.0
	var s: Node = get_node_or_null(^"/root/Settings")
	if s != null:
		mult = {"low": 0.6, "medium": 0.8, "high": 1.0, "ultra": 1.5}.get(str(s.call(&"get_value", "graphics", "quality", "high")), 1.0)
	for g in ["Buildings", "Landmarks", "StreetFurniture", "Nature", "Water", "Festival", "Interactables", "Connectors", "Cables"]:
		var root_n := get_node_or_null(g)
		if root_n == null:
			continue
		var stack: Array[Node] = [root_n]
		while not stack.is_empty():
			var n: Node = stack.pop_back()
			for c in n.get_children():
				stack.append(c)
			var gi := n as GeometryInstance3D
			if gi == null or gi is MultiMeshInstance3D or gi.visibility_range_end > 0.0:
				continue
			var size := gi.get_aabb().size
			var sc := 1.0
			var p: Node = gi
			while p != null and p != self:
				if p is Node3D:
					sc *= (p as Node3D).scale.x
				p = p.get_parent()
			var extent := maxf(size.x, maxf(size.y, size.z)) * absf(sc)
			var end := 0.0
			if extent < 0.6:
				end = 32.0
			elif extent < 1.6:
				end = 55.0
			elif extent < 4.0:
				end = 95.0
			elif extent < 9.0 and g != "Buildings":
				end = 170.0
			if end > 0.0:
				gi.visibility_range_end = end * mult
				gi.visibility_range_end_margin = end * mult * 0.1
				visibility_ranged += 1


func _ready() -> void:
	add_to_group(&"city")
	if not has_meta(&"map_bounds"):
		set_meta(&"map_bounds", Rect2(-124.0, -98.0, 248.0, 212.0))
	weather = get_node_or_null(^"WeatherSystem")
	environment_ctrl = get_node_or_null(^"WorldEnvironment")
	night_lights = get_node_or_null(^"NightLights")
	GameEvents.area_entered.connect(_on_area_entered)


func _on_area_entered(_id: StringName) -> void:
	pass


func get_weather_system() -> Node:
	return weather


func get_player_spawn() -> Marker3D:
	return get_tree().get_first_node_in_group(&"player_spawn") as Marker3D


func get_spawn_transform() -> Transform3D:
	var m := get_player_spawn()
	return m.global_transform if m != null else Transform3D(Basis(), Vector3(0, 1, 0))


## Locations by id (group "location").
func find_location(location_id: StringName) -> Node3D:
	for n in get_tree().get_nodes_in_group(&"location"):
		if StringName(str(n.get_meta(&"location_id", ""))) == location_id:
			return n as Node3D
	return null


# --- QA hooks -------------------------------------------------------------------------------------

func qa_rain() -> void:
	weather.call(&"set_weather_immediate", &"rain", 0.85, 0.9)


func qa_storm() -> void:
	weather.call(&"set_weather_immediate", &"storm", 1.0, 1.0)
	weather.call(&"trigger_lightning", 400.0)


func qa_fog() -> void:
	weather.call(&"set_weather_immediate", &"fog", 1.0, 0.25)


func qa_cloudy() -> void:
	weather.call(&"set_weather_immediate", &"cloudy", 0.8, 0.0)


func qa_clear() -> void:
	weather.call(&"set_weather_immediate", &"clear", 0.0, 0.0)


func qa_festival() -> void:
	if night_lights != null:
		night_lights.call(&"set_festival_override", 1)


func qa_perf() -> void:
	_perf_frames = 40


func _process(_delta: float) -> void:
	if _perf_frames > 0:
		_perf_frames -= 1
		if _perf_frames == 0:
			print("PERF draw_calls=%d primitives=%d objects=%d video_mem_MB=%.1f fps=%.1f" % [
				Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME),
				Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED) / 1048576.0,
				Performance.get_monitor(Performance.TIME_FPS)])
