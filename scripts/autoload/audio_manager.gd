## Plays landing/jump/meow/item/quest/menu sounds automatically from GameEvents (see docs/areas/audio.md).
@export var react_to_events := true
## Auto music by phase of day / festival / dog chase (any explicit play_music() overrides until resume_auto_music()).
@export var music_auto := true
## Silence between auto music plays (seconds, random in range). Vector2.ZERO = loop continuously.
@export var music_rest_range := Vector2(35.0, 80.0)
## Random positional "spot" sounds around the listener (birds, horns, geckos...).
@export var spot_sounds_enabled := true
## Global footstep offset (e.g. -6 for the silent-paws skill).
@export var footstep_gain_db := 0.0

var _bank: Dictionary = {}          # StringName -> Dictionary
var _streams: Dictionary = {}       # StringName -> Array (AudioStream per variant, null until loaded)
var _last_variant: Dictionary = {}  # StringName -> int
var _warned: Dictionary = {}
var _recent: Dictionary = {}        # StringName -> [time_s, Vector3]
var _pool3d: Array[AudioStreamPlayer3D] = []
var _pool2d: Array[AudioStreamPlayer] = []
var _poolui: Array[AudioStreamPlayer] = []
var _meta: Dictionary = {}          # player -> {"t": float, "prio": int}
var _bus_idx: Dictionary = {}       # StringName -> int
var _pending: Dictionary = {}       # path -> Array[Callable] (threaded loads)

# music
var _music: Array[AudioStreamPlayer] = []
var _music_cur := 0
var _music_name: StringName = &""
var _music_override := false
var _music_started := 0.0
var _music_fading_out := false
var _rest_until := 0.0
var _stinger: AudioStreamPlayer
var _chase_until := 0.0
var _chasing := false
var _ducks: Dictionary = {}         # reason -> Vector2(music_db, ambience_db)
var _duck_tweens: Dictionary = {}

# ambience
var _layers: Dictionary = {}        # layer -> {"players": [p, p], "cur": int, "name": StringName, "db": float}
var _area_key: StringName = &"street"
var _area_id: StringName = &""
var _area_overrides: Dictionary = {}
var _phase: StringName = &"day"
var _weather: StringName = &"clear"
var _weather_intensity := 0.0
var _sheltered := false
var _amb_override: StringName = &""
var _next_spot: Dictionary = {}     # spot name -> time
var _next_thunder := 0.0
var _next_gust := 0.0
var _menus_open: Dictionary = {}
var _paused_muffle := false
var _sense_active := false
var _player: Node3D
var _time := 0.0
var _rng := RandomNumberGenerator.new()
## False with the Dummy driver (headless tests/servers): nothing would be mixed, and playbacks started on the
## Dummy driver are never reaped, so we resolve/route everything but do not start playback.
var _output_enabled := true


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.randomize()
	_output_enabled = AudioServer.get_driver_name() != "Dummy"
	_load_bank()
	_cache_buses()
	_build_pools()
	_apply_volumes()
	if react_to_events:
		_connect_events()
	var tod := get_node_or_null(^"/root/TimeOfDay")
	if tod != null and tod.has_method(&"get_phase"):
		var ph: Variant = tod.call(&"get_phase")
		if ph is StringName or ph is String:
			_phase = StringName(ph)
	_preload_group([&"foley", &"ui", &"cat"])


# =========================================================================================== bank
func _load_bank() -> void:
	_bank.clear()
	if not FileAccess.file_exists(BANK_PATH):
		push_warning("AudioManager: %s missing — run tools/audio/build.sh" % BANK_PATH)
		return
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(BANK_PATH))
	if not (data is Dictionary) or not (data as Dictionary).has("sounds"):
		push_warning("AudioManager: invalid bank file")
		return
	var sounds: Dictionary = data["sounds"]
	for k: String in sounds:
		var e: Dictionary = sounds[k]
		_bank[StringName(k)] = e
		var arr: Array = []
		arr.resize((e.get("files", []) as Array).size())
		_streams[StringName(k)] = arr


func has_sound(sound: StringName) -> bool:
	return _bank.has(sound)


func get_sound_names() -> PackedStringArray:
	var out := PackedStringArray()
	for k: StringName in _bank:
		out.append(String(k))
	out.sort()
	return out


func get_sound_info(sound: StringName) -> Dictionary:
	return _bank.get(sound, {})


func get_variant_count(sound: StringName) -> int:
	return (_bank.get(sound, {}).get("files", []) as Array).size()


## Returns the stream for a variant (random non-repeating variant when variant < 0); loads synchronously if needed.
func get_stream(sound: StringName, variant: int = -1) -> AudioStream:
	if not _bank.has(sound):
		return null
	var files: Array = _bank[sound].get("files", [])
	if files.is_empty():
		return null
	var i := variant
	if i < 0:
		i = _pick_variant(sound, files.size())
	i = clampi(i, 0, files.size() - 1)
	var arr: Array = _streams[sound]
	var s: AudioStream = arr[i]
	if s == null:
		if not _importable(sound, String(files[i])):
			return null
		s = load(String(files[i])) as AudioStream
		if s != null:
			_configure_stream(sound, s)
		arr[i] = s
	return s


func _importable(sound: StringName, path: String) -> bool:
	## A bank file that is not imported yet (fresh checkout before tools/godot_import.sh) is skipped with one warning.
	if ResourceLoader.exists(path, "AudioStream"):
		return true
	var key := StringName("missing:" + String(sound))
	if not _warned.has(key):
		_warned[key] = true
		push_warning("AudioManager: '%s' not imported yet (%s) — run tools/godot_import.sh" % [sound, path])
	return false


func _pick_variant(sound: StringName, count: int) -> int:
	if count <= 1:
		return 0
	var last: int = _last_variant.get(sound, -1)
	var i := _rng.randi_range(0, count - 2)
	if i >= last:
		i += 1
	_last_variant[sound] = i
	return i


func _configure_stream(sound: StringName, s: AudioStream) -> void:
	var looped: bool = _bank[sound].get("loop", false)
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = looped
	elif s is AudioStreamWAV:
		var w := s as AudioStreamWAV
		if looped:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_end = int(w.get_length() * w.mix_rate)


## Kicks off background loads for every sound in the given groups (small one-shots) so first plays never hitch.
func _preload_group(groups: Array) -> void:
	for k: StringName in _bank:
		var e: Dictionary = _bank[k]
		if StringName(e.get("group", "")) in groups or StringName(e.get("category", "")) in groups:
			for v in (e.get("files", []) as Array).size():
				_request_async(k, v, func(_s: AudioStream) -> void: pass)


func _request_async(sound: StringName, variant: int, cb: Callable) -> void:
	## Threaded load for big streams (music/ambience); cb(stream) is called when ready.
	var files: Array = _bank[sound].get("files", [])
	var path: String = files[variant]
	var arr: Array = _streams[sound]
	if arr[variant] != null:
		cb.call(arr[variant])
		return
	if not _importable(sound, path):
		cb.call(null)
		return
	if ResourceLoader.has_cached(path):
		var s := load(path) as AudioStream
		_configure_stream(sound, s)
		arr[variant] = s
		cb.call(s)
		return
	if not _pending.has(path):
		_pending[path] = []
		ResourceLoader.load_threaded_request(path, "AudioStream")
	(_pending[path] as Array).append(func(s: AudioStream) -> void:
		if s != null:
			_configure_stream(sound, s)
			arr[variant] = s
		cb.call(s))


func _poll_pending() -> void:
	if _pending.is_empty():
		return
	for path: String in _pending.keys():
		var st := ResourceLoader.load_threaded_get_status(path)
		if st == ResourceLoader.THREAD_LOAD_IN_PROGRESS:
			continue
		var s: AudioStream = null
		if st == ResourceLoader.THREAD_LOAD_LOADED:
			s = ResourceLoader.load_threaded_get(path) as AudioStream
		else:
			s = load(path) as AudioStream
		var cbs: Array = _pending[path]
		_pending.erase(path)
		for cb: Callable in cbs:
			cb.call(s)


func _warn_unknown(sound: StringName) -> void:
	if not _warned.has(sound):
		_warned[sound] = true
		push_warning("AudioManager: unknown sound '%s' (no-op)" % sound)


# =========================================================================================== buses
func _cache_buses() -> void:
	_bus_idx.clear()
	for i in AudioServer.bus_count:
		_bus_idx[AudioServer.get_bus_name(i)] = i


func bus_index(bus_name: StringName) -> int:
	return _bus_idx.get(bus_name, AudioServer.get_bus_index(bus_name))


func _bus_name(sound: StringName) -> StringName:
	var b := StringName(_bank[sound].get("bus", "SFX"))
	return b if bus_index(b) >= 0 else &"Master"


func _find_effect(bus_name: StringName, effect_name: String) -> AudioEffect:
	var idx := bus_index(bus_name)
	if idx < 0:
		return null
	for i in AudioServer.get_bus_effect_count(idx):
		var e := AudioServer.get_bus_effect(idx, i)
		if e != null and e.resource_name == effect_name:
			return e
	return null


## Slider value 0..1 -> bus gain (perceptual: 40*log10(v), i.e. 0.5 ≈ -12 dB). 0 mutes.
func set_bus_level(bus_name: StringName, value: float) -> void:
	var idx := bus_index(bus_name)
	if idx < 0:
		return
	var v := clampf(value, 0.0, 1.0)
	AudioServer.set_bus_mute(idx, v <= 0.001)
	AudioServer.set_bus_volume_db(idx, 40.0 * log(maxf(v, 0.001)) / log(10.0))


func _apply_volumes() -> void:
	var settings := get_node_or_null(^"/root/Settings")
	var getv := func(key: String, def: float) -> float:
		if settings != null and settings.has_method(&"get_value"):
			var v: Variant = settings.call(&"get_value", "audio", key, def)
			if v is float or v is int:
				return float(v)
		return def
	set_bus_level(&"Master", getv.call("master", 1.0))
	set_bus_level(&"Music", getv.call("music", 0.7))
	set_bus_level(&"SFX", getv.call("sfx", 1.0))
	set_bus_level(&"Voice", 1.0)  # Voice is routed through SFX, so it follows the SFX slider
	set_bus_level(&"Ambience", getv.call("ambience", 0.9))
	set_bus_level(&"UI", getv.call("ui", 0.8))


# =========================================================================================== pools
func _build_pools() -> void:
	for i in POOL_3D_SIZE:
		var p := AudioStreamPlayer3D.new()
		p.name = "Sfx3D_%d" % i
		p.process_mode = Node.PROCESS_MODE_PAUSABLE
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p.attenuation_filter_cutoff_hz = 6500.0
		p.attenuation_filter_db = -14.0
		p.max_db = 3.0
		p.area_mask = 1 | (1 << 9)  # layer 1 (world) and 10 (triggers) reverb/bus Area3Ds
		add_child(p)
		p.finished.connect(_on_voice_finished.bind(p))
		_pool3d.append(p)
	for i in POOL_2D_SIZE:
		var p2 := AudioStreamPlayer.new()
		p2.name = "Sfx2D_%d" % i
		p2.process_mode = Node.PROCESS_MODE_PAUSABLE
		add_child(p2)
		p2.finished.connect(_on_voice_finished.bind(p2))
		_pool2d.append(p2)
	for i in POOL_UI_SIZE:
		var pu := AudioStreamPlayer.new()
		pu.name = "Ui_%d" % i
		pu.bus = &"UI"
		add_child(pu)
		_poolui.append(pu)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.name = "Music_%d" % i
		m.bus = &"Music"
		m.volume_linear = 0.0
		add_child(m)
		_music.append(m)
	_stinger = AudioStreamPlayer.new()
	_stinger.name = "Stinger"
	_stinger.bus = &"Music"
	add_child(_stinger)
	for layer: StringName in [&"base", &"overlay", &"weather", &"shelter", &"wind"]:
		var ps: Array[AudioStreamPlayer] = []
		for i in 2:
			var a := AudioStreamPlayer.new()
			a.name = "Amb_%s_%d" % [layer, i]
			a.bus = &"Ambience"
			a.volume_linear = 0.0
			add_child(a)
			ps.append(a)
		_layers[layer] = {"players": ps, "cur": 0, "name": &"", "db": 0.0}


func _start(p: Node, from := 0.0) -> void:
	if _output_enabled:
		p.call(&"play", from)


func output_enabled() -> bool:
	return _output_enabled


func _on_voice_finished(p: Node) -> void:
	_meta.erase(p)


func _grab(pool: Array, prio: int) -> Node:
	var best: Node = null
	var best_score := INF
	for p: Node in pool:
		var playing: bool = p.call(&"is_playing")
		if not playing:
			return p
		var m: Dictionary = _meta.get(p, {"t": 0.0, "prio": 0})
		if int(m["prio"]) > prio:
			continue
		var score := float(m["prio"]) * 1000.0 + float(m["t"])  # lowest priority, then oldest
		if score < best_score:
			best_score = score
			best = p
	return best


func active_voice_count() -> int:
	var c := 0
	for p in _pool3d:
		if p.playing:
			c += 1
	for p in _pool2d:
		if p.playing:
			c += 1
	return c


# =========================================================================================== one-shots
## Contract API. pos == Vector3.INF plays non-positionally on the sound's bus.
func play_sfx(sound: StringName, pos: Vector3 = Vector3.INF, volume_db := 0.0, pitch_jitter := 0.05) -> void:
	play_at(sound, pos, volume_db, 1.0, pitch_jitter)


## Extended one-shot: returns the player used (or null). bus_override "" keeps the bank bus.
func play_at(sound: StringName, pos: Vector3 = Vector3.INF, volume_db := 0.0, pitch_scale := 1.0, pitch_jitter := 0.05,
		bus_override: StringName = &"", priority := -1) -> Node:
	if not _bank.has(sound):
		_warn_unknown(sound)
		return null
	if _is_duplicate(sound, pos):
		return null
	var e: Dictionary = _bank[sound]
	var s := get_stream(sound)
	if s == null:
		return null
	var prio: int = priority if priority >= 0 else int(e.get("priority", 5))
	var jit := pitch_jitter if float(e.get("pitch_jitter", 0.0)) > 0.0 else 0.0
	var pitch := pitch_scale * (1.0 + _rng.randf_range(-jit, jit))
	var vol := float(e.get("volume_db", 0.0)) + volume_db
	var bus := bus_override if bus_override != &"" else _bus_name(sound)
	if pos == Vector3.INF or not pos.is_finite():
		var p2 := _grab(_pool2d, prio) as AudioStreamPlayer
		if p2 == null:
			return null
		p2.stop()
		p2.stream = s
		p2.bus = bus
		p2.volume_db = vol
		p2.pitch_scale = pitch
		_start(p2)
		_meta[p2] = {"t": _time, "prio": prio}
		return p2
	var p := _grab(_pool3d, prio) as AudioStreamPlayer3D
	if p == null:
		return null
	p.stop()
	p.stream = s
	p.bus = bus
	p.volume_db = vol
	p.pitch_scale = pitch
	p.unit_size = float(e.get("unit_size", 3.0))
	p.max_distance = float(e.get("max_distance", 0.0))
	p.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
	p.global_position = pos
	_start(p)
	_meta[p] = {"t": _time, "prio": prio}
	return p


func _is_duplicate(sound: StringName, pos: Vector3) -> bool:
	## Same sound re-triggered within 50 ms at (nearly) the same place = double trigger (anim event + signal).
	var r: Array = _recent.get(sound, [])
	var now := _time
	if not r.is_empty() and now - float(r[0]) < 0.05:
		var rp: Vector3 = r[1]
		if (not pos.is_finite() and not rp.is_finite()) or (pos.is_finite() and rp.is_finite() and rp.distance_to(pos) < 0.5):
			return true
	_recent[sound] = [now, pos]
	return false


## Contract API: UI sounds (non-positional, UI bus, never paused).
func play_ui(sound: StringName, volume_db := 0.0) -> void:
	if not _bank.has(sound):
		_warn_unknown(sound)
		return
	if _is_duplicate(sound, Vector3.INF):
		return
	var s := get_stream(sound)
	if s == null:
		return
	var p := _grab(_poolui, 100) as AudioStreamPlayer
	if p == null:
		return
	p.stop()
	p.stream = s
	p.bus = &"UI"
	p.volume_db = float(_bank[sound].get("volume_db", 0.0)) + volume_db
	p.pitch_scale = 1.0
	_start(p)


## Attach a looping emitter to a moving/static node (vehicles, AC units, purring...). Returns the player;
## stop it with stop_loop(). pitch_scale can be animated by the caller (e.g. engine rpm).
func play_loop(sound: StringName, target: Node3D, volume_db := 0.0, pitch_scale := 1.0, doppler := false) -> AudioStreamPlayer3D:
	if not _bank.has(sound):
		_warn_unknown(sound)
		return null
	if target == null or not is_instance_valid(target):
		return null
	var s := get_stream(sound)
	if s == null:
		return null
	var e: Dictionary = _bank[sound]
	var p := AudioStreamPlayer3D.new()
	p.name = "Loop_%s" % sound
	p.stream = s
	p.bus = _bus_name(sound)
	p.volume_db = float(e.get("volume_db", 0.0)) + volume_db
	p.pitch_scale = pitch_scale
	p.unit_size = float(e.get("unit_size", 3.0))
	p.max_distance = float(e.get("max_distance", 0.0))
	p.attenuation_filter_cutoff_hz = 6500.0
	p.attenuation_filter_db = -14.0
	p.area_mask = 1 | (1 << 9)
	p.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_PHYSICS_STEP if doppler else AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
	p.autoplay = false
	target.add_child(p)
	_start(p, _rng.randf() * maxf(s.get_length() - 0.1, 0.0))
	return p


func stop_loop(player: AudioStreamPlayer3D, fade := 0.3) -> void:
	if player == null or not is_instance_valid(player):
		return
	if fade <= 0.0:
		player.queue_free()
		return
	var tw := player.create_tween()
	tw.tween_property(player, "volume_db", -60.0, fade)
	tw.tween_callback(player.queue_free)


# =========================================================================================== cat helpers
## Footsteps (contract). intensity 0..1: sneak ~0.2, walk ~0.4, trot ~0.6, run ~0.9.
func play_footstep(surface: StringName, pos: Vector3, intensity: float) -> void:
	var it := clampf(intensity, 0.0, 1.0)
	var sound := resolve_footstep_sound(surface, it)
	var vol := linear_to_db(lerpf(0.14, 1.0, pow(it, 0.8))) + footstep_gain_db
	var pitch := 1.0 + (it - 0.5) * 0.06
	play_at(sound, pos, vol, pitch, 0.06)
	var s := resolve_surface(surface)
	if _is_wet() and it > 0.15 and s in WET_SURFACES:
		play_at(&"step_wet", pos, vol - 3.0 + linear_to_db(clampf(_weather_intensity + 0.3, 0.3, 1.0)), pitch, 0.08)


func resolve_surface(surface: StringName) -> StringName:
	if surface in SURFACES:
		return surface
	var s := StringName(String(surface).to_lower())
	if s in SURFACES:
		return s
	return SURFACE_ALIASES.get(s, &"concrete")


func resolve_footstep_sound(surface: StringName, intensity: float) -> StringName:
	var s := resolve_surface(surface)
	if intensity >= 0.72 and _bank.has(StringName("step_%s_run" % s)):
		return StringName("step_%s_run" % s)
	return StringName("step_%s" % s)


func resolve_landing_sound(surface: StringName, impact_speed: float) -> StringName:
	var fam: StringName = LANDING_FAMILY.get(resolve_surface(surface), &"stone")
	return StringName("land_%s_%s" % ["hard" if impact_speed >= 5.0 else "soft", fam])


## Landing from a jump/fall. impact_speed in m/s (vertical). Tiny drops become a footstep.
func play_landing(surface: StringName, pos: Vector3, impact_speed: float) -> void:
	if impact_speed < 1.2:
		play_footstep(surface, pos, 0.5)
		return
	var sound := resolve_landing_sound(surface, impact_speed)
	var vol := 0.0
	if impact_speed < 5.0:
		vol = lerpf(-10.0, 0.0, clampf((impact_speed - 1.2) / 3.8, 0.0, 1.0))
	else:
		vol = lerpf(0.0, 2.5, clampf((impact_speed - 5.0) / 5.0, 0.0, 1.0))
	play_at(sound, pos, vol + footstep_gain_db * 0.5, 1.0, 0.05)
	if _is_wet() and resolve_surface(surface) in WET_SURFACES:
		play_at(&"step_wet", pos, vol, 0.95, 0.05)


## kind: short|chirp|trill|loud|question|demand|greet|complain|soft|purr|hiss|growl|yowl|yawn (unknown -> short).
func play_meow(kind: StringName, pos: Vector3 = Vector3.INF, pitch_scale := 1.0) -> void:
	var sound := resolve_meow_sound(kind)
	play_at(sound, pos, 0.0, pitch_scale, 0.04)


func resolve_meow_sound(kind: StringName) -> StringName:
	match kind:
		&"chirp":
			return &"cat_meow_chirp" if _rng.randf() < 0.6 else &"cat_meow_trill"
		&"purr":
			return &"cat_purr"
		&"hiss", &"growl", &"yowl", &"yawn", &"sniff":
			return StringName("cat_%s" % kind)
	var n := StringName("cat_meow_%s" % kind)
	return n if _bank.has(n) else &"cat_meow_short"


# =========================================================================================== music
## Contract API. Crossfades to a music track; an explicit call overrides auto music until resume_auto_music().
func play_music(track: StringName, fade := 2.0) -> void:
	_music_override = true
	_start_music(track, fade)


func _start_music(track: StringName, fade: float) -> void:
	if not _bank.has(track):
		_warn_unknown(track)
		return
	if track == _music_name and _music[_music_cur].playing and not _music_fading_out:
		return
	_music_name = track
	_music_fading_out = false
	var v := _pick_variant(track, get_variant_count(track))
	_request_async(track, v, func(s: AudioStream) -> void:
		if s == null or _music_name != track:
			return
		var old := _music[_music_cur]
		_music_cur = 1 - _music_cur
		var nw := _music[_music_cur]
		nw.stream = s
		nw.volume_linear = 0.0 if fade > 0.0 else 1.0
		_start(nw)
		_music_started = _time
		_fade_player(nw, 1.0, fade)
		_fade_player(old, 0.0, fade, true))


## Contract API. Also suspends auto music until resume_auto_music() (or the next player spawn).
func stop_music(fade := 2.0) -> void:
	_music_override = true
	_stop_all_music(fade)


func _stop_all_music(fade: float) -> void:
	_music_name = &""
	_music_fading_out = false
	for p in _music:
		_fade_player(p, 0.0, fade, true)


func get_current_music() -> StringName:
	return _music_name


func resume_auto_music() -> void:
	_music_override = false
	_update_auto_music(true)


## Short musical cue over the music, which is ducked while it plays.
func play_stinger(sound: StringName, duck_db := -10.0) -> void:
	if not _bank.has(sound):
		_warn_unknown(sound)
		return
	var s := get_stream(sound)
	if s == null:
		return
	_stinger.stop()
	_stinger.stream = s
	_start(_stinger)
	duck(&"stinger", duck_db, 0.0, 0.25)
	var slen := s.get_length()
	get_tree().create_timer(maxf(slen - 0.8, 0.3), true, false, true).timeout.connect(
		func() -> void: unduck(&"stinger", 1.2))


## Duck Music/Ambience for a reason (dialogue, stinger, cat_sense...). The deepest active duck wins.
func duck(reason: StringName, music_db := -9.0, ambience_db := -4.0, fade := 0.4) -> void:
	_ducks[reason] = Vector2(music_db, ambience_db)
	_apply_ducks(fade)


func unduck(reason: StringName, fade := 0.8) -> void:
	_ducks.erase(reason)
	_apply_ducks(fade)


func _apply_ducks(fade: float) -> void:
	var m := 0.0
	var a := 0.0
	for k: StringName in _ducks:
		var d: Vector2 = _ducks[k]
		m = minf(m, d.x)
		a = minf(a, d.y)
	_tween_effect(&"Music", "Duck", "volume_db", m, fade)
	_tween_effect(&"Ambience", "Duck", "volume_db", a, fade)


func _tween_effect(bus_name: StringName, effect_name: String, prop: String, value: float, fade: float) -> void:
	var e := _find_effect(bus_name, effect_name)
	if e == null:
		return
	var key := "%s/%s/%s" % [bus_name, effect_name, prop]
	if _duck_tweens.has(key) and is_instance_valid(_duck_tweens[key]):
		(_duck_tweens[key] as Tween).kill()
	if fade <= 0.0 or not is_inside_tree():
		e.set(prop, value)
		return
	var tw := create_tween()
	tw.tween_property(e, prop, value, fade)
	_duck_tweens[key] = tw


func _fade_player(p: AudioStreamPlayer, target: float, fade: float, stop_after := false) -> void:
	if p.has_meta(&"fade_tween"):
		var old: Variant = p.get_meta(&"fade_tween")
		if old is Tween and is_instance_valid(old):
			(old as Tween).kill()
	if fade <= 0.0 or not is_inside_tree():
		p.volume_linear = target
		if stop_after and target <= 0.0:
			p.stop()
		return
	var tw := create_tween()
	tw.tween_property(p, "volume_linear", target, fade)
	if stop_after and target <= 0.0:
		tw.tween_callback(p.stop)
	p.set_meta(&"fade_tween", tw)


func _auto_music_track() -> StringName:
	if _chasing:
		return &"mus_tension"
	var festival := _festival_active()
	match _phase:
		&"night", &"dusk":
			return &"mus_festival" if festival else &"mus_night"
		_:
			return &"mus_morning"


func _update_auto_music(force := false) -> void:
	if not music_auto or _music_override:
		return
	if _time < _rest_until and not _chasing and not force:
		return
	var t := _auto_music_track()
	if t != _music_name or force:
		_start_music(t, 3.0 if not _chasing else 1.0)


func _tick_music() -> void:
	if not music_auto or _music_override or _music_name == &"":
		if music_auto and not _music_override and _music_name == &"" and _time >= _rest_until and _player != null:
			_update_auto_music()
		return
	if _chasing and _time > _chase_until:
		_chasing = false
		play_stinger(&"stinger_chase_end", -12.0)
		_rest_until = _time + 6.0
		_stop_all_music(2.5)
		return
	if _chasing or music_rest_range == Vector2.ZERO:
		return
	var s := _music[_music_cur].stream
	if s == null or _music_name in [&"mus_festival", &"mus_menu", &"mus_tension"]:
		return
	var length := s.get_length()
	if length > 10.0 and _time - _music_started > length - 5.0 and not _music_fading_out:
		_music_fading_out = true
		for p in _music:
			_fade_player(p, 0.0, 5.0, true)
		_rest_until = _time + 5.0 + _rng.randf_range(music_rest_range.x, music_rest_range.y)
		get_tree().create_timer(5.0, true, false, true).timeout.connect(func() -> void:
			if _music_fading_out:
				_music_name = &""
				_music_fading_out = false)


func _festival_active() -> bool:
	var gs := get_node_or_null(^"/root/GameState")
	if gs != null and gs.has_method(&"get_flag"):
		return bool(gs.call(&"get_flag", &"festival_active", false))
	return false


# =========================================================================================== ambience
## Contract API: force an ambience bed (bank name, e.g. &"amb_market"). Empty name returns to automatic.
func set_ambience(bed: StringName, fade := 2.0) -> void:
	if bed != &"" and not _bank.has(bed):
		_warn_unknown(bed)
		return
	_amb_override = bed
	_refresh_ambience(fade)


func register_area_ambience(area_id: StringName, bed_key_or_name: StringName) -> void:
	_area_overrides[area_id] = bed_key_or_name


func set_sheltered(sheltered: bool) -> void:
	if sheltered == _sheltered:
		return
	_sheltered = sheltered
	_refresh_ambience(1.0)


func get_layer_sound(layer: StringName) -> StringName:
	return _layers[layer]["name"] if _layers.has(layer) else &""


func get_current_ambience() -> StringName:
	return get_layer_sound(&"base")


func area_key_for(area_id: StringName) -> StringName:
	if _area_overrides.has(area_id):
		return _area_overrides[area_id]
	var s := String(area_id).to_lower()
	for kw: Array in AREA_KEYWORDS:
		if s.contains(String(kw[0])):
			return kw[1]
	return &"street"


## Pure resolution used by the director and tests: returns {"base","overlay","weather","shelter","wind"} -> [name, db].
func resolve_ambience(area_key: StringName, phase: StringName, weather: StringName, intensity: float,
		sheltered := false, festival := false) -> Dictionary:
	var night := phase == &"night"
	var evening := phase == &"dusk" or night
	var base: StringName = area_key
	if base.begins_with("amb_"):
		pass
	else:
		match area_key:
			&"market":
				base = &"amb_street_night" if night else &"amb_market"
			&"lake":
				base = &"amb_lake"
			&"temple":
				base = &"amb_temple"
			&"alley":
				base = &"amb_alley"
			&"rooftop":
				base = &"amb_rooftop"
			&"festival":
				base = &"amb_festival"
			_:
				base = &"amb_street_night" if night else &"amb_street_day"
		if festival and evening and area_key in [&"street", &"market", &"temple", &"festival"]:
			base = &"amb_festival"
	var raining := weather in [&"rain", &"storm"]
	var out := {"base": [base, 0.0], "overlay": [&"", 0.0], "weather": [&"", 0.0], "shelter": [&"", 0.0], "wind": [&"", 0.0]}
	if phase == &"dawn" and base != &"amb_alley":
		out["overlay"] = [&"amb_dawn_chorus", -3.0 - (10.0 if raining else 0.0)]
	elif evening and base in [&"amb_lake", &"amb_temple", &"amb_rooftop", &"amb_alley"]:
		out["overlay"] = [&"amb_night_insects", (-2.0 if night else -8.0) - (10.0 if raining else 0.0)]
	if raining:
		var heavy := weather == &"storm" or intensity >= 0.6
		var rdb := linear_to_db(clampf(0.35 + 0.65 * intensity, 0.2, 1.0))
		out["weather"] = [&"rain_heavy_loop" if heavy else &"rain_light_loop", rdb - (8.0 if sheltered else 0.0)]
		if sheltered:
			out["shelter"] = [&"rain_tin_loop", rdb]
		out["base"] = [base, -3.0 * intensity]
	if weather == &"storm" or (base == &"amb_rooftop" and raining and intensity > 0.7):
		out["wind"] = [&"wind_storm_loop", -2.0 if base == &"amb_rooftop" else -5.0]
	return out


func _refresh_ambience(fade := 2.0) -> void:
	var r := resolve_ambience(_area_key, _phase, _weather, _weather_intensity, _sheltered, _festival_active())
	if _amb_override != &"":
		r["base"] = [_amb_override, 0.0]
	for layer: StringName in [&"base", &"overlay", &"weather", &"shelter", &"wind"]:
		var v: Array = r[String(layer)]
		_set_layer(layer, v[0], float(v[1]), fade)


func _set_layer(layer: StringName, sound: StringName, db: float, fade: float) -> void:
	var L: Dictionary = _layers[layer]
	var ps: Array = L["players"]
	if sound == L["name"]:
		if absf(db - float(L["db"])) > 0.1 and sound != &"":
			L["db"] = db
			_fade_player(ps[L["cur"]], db_to_linear(db), fade)
		return
	var old: AudioStreamPlayer = ps[L["cur"]]
	_fade_player(old, 0.0, fade, true)
	L["name"] = sound
	L["db"] = db
	if sound == &"" or not _bank.has(sound):
		if sound != &"":
			_warn_unknown(sound)
		return
	var v := _pick_variant(sound, get_variant_count(sound))
	_request_async(sound, v, func(s: AudioStream) -> void:
		if s == null or L["name"] != sound:
			return
		L["cur"] = 1 - int(L["cur"])
		var nw: AudioStreamPlayer = ps[L["cur"]]
		nw.stream = s
		nw.volume_linear = 0.0
		_start(nw, _rng.randf() * maxf(s.get_length() - 1.0, 0.0))  # random start: no audible "restart" on area changes
		_fade_player(nw, db_to_linear(float(L["db"])), fade))


func _tick_spots(_delta: float) -> void:
	if not spot_sounds_enabled or get_tree().paused:
		return
	var cam := get_viewport().get_camera_3d() if get_viewport() != null else null
	if cam == null:
		return
	var bed := get_current_ambience()
	var spots: Array = SPOTS.get(bed, [])
	var center := cam.global_position
	for sp: Array in spots:
		var nm := StringName(sp[0])
		var key := StringName("%s/%s" % [bed, nm])
		if not _next_spot.has(key):
			_next_spot[key] = _time + _rng.randf_range(0.2, 1.0) * float(sp[1])
			continue
		if _time < float(_next_spot[key]):
			continue
		_next_spot[key] = _time + float(sp[1]) * _rng.randf_range(0.5, 1.5)
		if _weather in [&"rain", &"storm"] and (String(nm).contains("chirp") or String(nm).contains("song") or String(nm).contains("coo")):
			continue  # birds hide in the rain
		var ang := _rng.randf() * TAU
		var dist := _rng.randf_range(float(sp[2]), float(sp[3]))
		var pos := center + Vector3(cos(ang) * dist, 0.0, sin(ang) * dist)
		pos.y = center.y + _rng.randf_range(float(sp[4]), float(sp[5])) - 0.2
		play_at(nm, pos, float(sp[6]), 1.0, 0.05, &"Ambience", 1)
	# weather one-shots (non-positional stereo)
	if _weather == &"storm" or (_weather == &"rain" and _weather_intensity > 0.75):
		if _next_thunder <= 0.0:
			_next_thunder = _time + _rng.randf_range(8.0, 20.0)
		elif _time >= _next_thunder:
			var near := _weather == &"storm" and _rng.randf() < 0.35
			play_at(&"thunder_near" if near else &"thunder_far", Vector3.INF, 0.0, 1.0, 0.0, &"Ambience", 9)
			_next_thunder = _time + (_rng.randf_range(12.0, 40.0) if _weather == &"storm" else _rng.randf_range(45.0, 110.0))
	else:
		_next_thunder = 0.0
	if _weather in [&"storm", &"cloudy"] or bed == &"amb_rooftop":
		if _next_gust <= 0.0:
			_next_gust = _time + _rng.randf_range(10.0, 30.0)
		elif _time >= _next_gust:
			play_at(&"wind_gust", Vector3.INF, -2.0 if _weather == &"storm" else -6.0, 1.0, 0.0, &"Ambience", 2)
			_next_gust = _time + _rng.randf_range(18.0, 55.0)
	else:
		_next_gust = 0.0


func _is_wet() -> bool:
	return _weather in [&"rain", &"storm"] and not _sheltered


# =========================================================================================== events
func _connect_events() -> void:
	var ge := get_node_or_null(^"/root/GameEvents")
	if ge == null:
		return
	var links := {
		&"player_spawned": _on_player_spawned, &"player_landed": _on_player_landed, &"player_jumped": _on_player_jumped,
		&"player_meowed": _on_player_meowed, &"item_picked_up": _on_item_picked_up, &"item_dropped": _on_item_dropped,
		&"quest_started": _on_quest_started, &"quest_completed": _on_quest_completed,
		&"quest_objective_updated": _on_objective, &"level_up": _on_level_up, &"skill_unlocked": _on_skill_unlocked,
		&"collectible_found": _on_collectible, &"location_discovered": _on_location_discovered,
		&"notify": _on_notify, &"game_saved": _on_game_saved, &"game_loaded": _on_game_loaded,
		&"dialogue_started": _on_dialogue_started, &"dialogue_ended": _on_dialogue_ended, &"dialogue_line": _on_dialogue_line,
		&"ui_menu_opened": _on_menu_opened, &"ui_menu_closed": _on_menu_closed, &"pause_requested": _on_pause_requested,
		&"cat_sense_toggled": _on_cat_sense, &"phase_of_day_changed": _on_phase_changed, &"weather_changed": _on_weather_changed,
		&"area_entered": _on_area_entered, &"npc_alerted": _on_npc_alerted, &"settings_changed": _on_settings_changed,
		&"territory_marked": _on_territory_marked,
	}
	for sig: StringName in links:
		if ge.has_signal(sig) and not ge.is_connected(sig, links[sig]):
			ge.connect(sig, links[sig])


func _player_pos() -> Vector3:
	if _player == null or not is_instance_valid(_player):
		_player = get_tree().get_first_node_in_group(&"player") as Node3D
	if _player == null or not _player.is_inside_tree():
		return Vector3.INF
	return _player.global_position


func _on_player_spawned(player: Node3D) -> void:
	_player = player
	_refresh_ambience(1.5)
	if music_auto:
		resume_auto_music()


func _on_player_landed(impact_speed: float, surface: StringName) -> void:
	var p := _player_pos()
	if p.is_finite():
		play_landing(surface, p, impact_speed)


func _on_player_jumped(charge: float) -> void:
	var p := _player_pos()
	if p.is_finite():
		play_at(&"cat_jump_effort", p, lerpf(-8.0, 0.0, clampf(charge, 0.0, 1.0)))


func _on_player_meowed(kind: StringName) -> void:
	var p := _player_pos()
	play_meow(kind, p if p.is_finite() else Vector3.INF)


func _on_item_picked_up(_item_id: StringName, _amount: int) -> void:
	play_ui(&"ui_item_get")


func _on_item_dropped(_item_id: StringName, _amount: int) -> void:
	var p := _player_pos()
	if p.is_finite():
		play_at(&"cat_drop", p)


func _on_quest_started(_id: StringName) -> void:
	play_ui(&"ui_quest_start")


func _on_quest_completed(_id: StringName) -> void:
	play_ui(&"ui_quest_complete")
	duck(&"quest_complete", -8.0, -3.0, 0.2)
	get_tree().create_timer(2.8, true, false, true).timeout.connect(func() -> void: unduck(&"quest_complete", 1.5))


func _on_objective(_q: StringName, _o: StringName, progress: int, required: int) -> void:
	if progress < required:
		play_ui(&"ui_notify", -6.0)


func _on_level_up(_lvl: int) -> void:
	play_ui(&"ui_level_up")
	duck(&"level_up", -8.0, -3.0, 0.2)
	get_tree().create_timer(3.0, true, false, true).timeout.connect(func() -> void: unduck(&"level_up", 1.5))


func _on_skill_unlocked(_id: StringName) -> void:
	play_ui(&"ui_skill_unlock")


func _on_collectible(_id: StringName) -> void:
	play_stinger(&"stinger_memory", -12.0)


func _on_location_discovered(_id: StringName, _display_name: String) -> void:
	play_ui(&"ui_discover")


func _on_notify(_text: String, _icon: StringName) -> void:
	play_ui(&"ui_notify", -2.0)


func _on_game_saved(_slot: int) -> void:
	play_ui(&"ui_save")


func _on_game_loaded(_slot: int) -> void:
	_refresh_ambience(1.0)


func _on_territory_marked(_spot: StringName) -> void:
	play_ui(&"ui_notify", -5.0)


func _on_dialogue_started(_id: StringName, _speaker: StringName) -> void:
	duck(&"dialogue", -9.0, -5.0, 0.5)


func _on_dialogue_ended(_id: StringName) -> void:
	unduck(&"dialogue", 1.0)


func _on_dialogue_line(_speaker: String, _text: String, _choices: PackedStringArray) -> void:
	play_ui(&"ui_dialogue_next", -4.0)


func _on_menu_opened(menu: StringName) -> void:
	_menus_open[menu] = true
	play_ui(&"ui_map_open" if menu == &"map" else &"ui_menu_open")
	_update_muffle()


func _on_menu_closed(menu: StringName) -> void:
	_menus_open.erase(menu)
	play_ui(&"ui_map_close" if menu == &"map" else &"ui_menu_close")
	_update_muffle()


func _on_pause_requested(paused: bool) -> void:
	_paused_muffle = paused
	_update_muffle()


func _update_muffle() -> void:
	var on := _paused_muffle or not _menus_open.is_empty()
	for b: StringName in [&"SFX", &"Ambience"]:
		_tween_effect(b, "Muffle", "cutoff_hz", 900.0 if on else 20500.0, 0.35)
	_tween_effect(&"Music", "Muffle", "cutoff_hz", 20500.0, 0.2)


func _on_cat_sense(active: bool) -> void:
	_sense_active = active
	play_ui(&"ui_cat_sense_on" if active else &"ui_cat_sense_off")
	if active:
		duck(&"cat_sense", -6.0, -4.0, 0.4)
		play_meow(&"sniff", _player_pos())
	else:
		unduck(&"cat_sense", 0.8)


func _on_phase_changed(phase: StringName) -> void:
	_phase = phase
	_refresh_ambience(6.0)
	_update_auto_music()


func _on_weather_changed(weather: StringName, intensity: float) -> void:
	_weather = weather
	_weather_intensity = clampf(intensity, 0.0, 1.0)
	_refresh_ambience(4.0)


func _on_area_entered(area_id: StringName) -> void:
	_area_id = area_id
	var key := area_key_for(area_id)
	if key == _area_key:
		return
	_area_key = key
	_refresh_ambience(3.0)


func _on_npc_alerted(npc: Node, alert_level: float) -> void:
	if npc == null or not is_instance_valid(npc):
		return
	var is_dog := npc.is_in_group(&"dog") or String(npc.get_meta(&"npc_kind", "")) == "dog"
	if not is_dog:
		var k: Variant = npc.get(&"npc_kind")
		is_dog = k != null and String(k) == "dog"
	if not is_dog:
		return
	if alert_level >= 0.85:
		_chase_until = _time + 8.0
		if not _chasing:
			_chasing = true
			if music_auto and not _music_override:
				_start_music(&"mus_tension", 0.8)
	elif alert_level < 0.3 and _chasing:
		_chase_until = minf(_chase_until, _time + 2.0)


func _on_settings_changed(section: StringName) -> void:
	if section == &"audio":
		_apply_volumes()


# =========================================================================================== process
func _exit_tree() -> void:
	# finish outstanding threaded loads and drop caches so nothing is left in use at shutdown
	for path: String in _pending.keys():
		if ResourceLoader.load_threaded_get_status(path) != ResourceLoader.THREAD_LOAD_INVALID_RESOURCE:
			ResourceLoader.load_threaded_get(path)
	_pending.clear()
	for c in get_children():
		if c is AudioStreamPlayer or c is AudioStreamPlayer3D:
			c.call(&"stop")
			c.set(&"stream", null)
	_meta.clear()
	for k: StringName in _streams:
		var arr: Array = _streams[k]
		arr.fill(null)


func _process(delta: float) -> void:
	_time += delta
	_poll_pending()
	_tick_music()
	_tick_spots(delta)
